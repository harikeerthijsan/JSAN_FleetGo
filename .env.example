# Railway production variables. Set on the WEB SERVICE; never commit real values.
NODE_ENV=production
LOG_LEVEL=info
# Replace Postgres if your database service has another name.
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Independently generated random values, at least 32 characters each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# HTTPS origin, no trailing slash. RAILWAY_PUBLIC_DOMAIN is also supported.
APP_PUBLIC_URL=https://your-service.up.railway.app
# CORS_ORIGINS=https://your-service.up.railway.app
TRUST_PROXY_HOPS=1
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Railway injects PORT. Attach a persistent Volume at /data before deployment.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/storage
TRACKING_WS_ENABLED=true
TRACKING_SIMULATION_ENABLED=false
# NEW database only. Unique 14-72 character password, upper/lowercase/number.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=FleetGo Administrator
BOOTSTRAP_ADMIN_PASSWORD=
# Remove bootstrap variables after setup. Deploys never reset passwords.
#
# Optional SMTP for password recovery. Without it, recovery reports unavailable.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=fleetgo@example.com
#
# Production GPS adapters: server-only credentials; never VITE_ variables.
# GPS_API_ALLOWED_HOSTS=api.your-provider.example
# GPS_PROVIDER_WEBHOOK_SECRET=
# GPS_PROVIDER_API_URL=
# GPS_PROVIDER_API_TOKEN=
