# FleetGo — environment variables for hosting (e.g. Railway).
# Set these in the Railway service "Variables" tab. DO NOT commit real secrets.
# The frontend needs no build-time variable: it calls the API at the same origin
# (/api/v1), because this one service serves both the API and the SPA.

# --- Required -------------------------------------------------------------
# Provided automatically when you add a Railway PostgreSQL plugin; reference it
# with: ${{ Postgres.DATABASE_URL }}
DATABASE_URL=

# Generate strong random values, e.g.  openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Recommended for production hosting -----------------------------------
NODE_ENV=production
# Railway injects PORT automatically; the app honours it. Leave unset on Railway.
# PORT=4000

# Same-origin hosting means CORS is not strictly needed, but you may pin it to
# your public domain, comma-separated.
# CORS_ORIGINS=https://your-app.up.railway.app

# Refresh cookie: Secure is derived from NODE_ENV=production (Railway is HTTPS).
# 'lax' is a safe default for same-origin hosting.
COOKIE_SAMESITE=lax

# --- Optional -------------------------------------------------------------
# LOG_LEVEL=info
# APP_NAME=FleetGo
# AUTH_RATE_LIMIT_MAX=10
# NOTE: uploaded files (vendor documents, ticket photos/videos) are written to
# the local filesystem, which is EPHEMERAL on Railway. For durable uploads,
# attach a Railway Volume and set STORAGE_LOCAL_PATH to its mount path, or wire
# an object-storage driver. Metadata is always safe in PostgreSQL.
# STORAGE_LOCAL_PATH=/data/storage
