# ============================================================================
# FleetGo Frontend — Environment Configuration (EXAMPLE)
# Copy this file to `.env` (or `.env.development` / `.env.production`).
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put secrets here — anything here ships to the client.
# ============================================================================

# Base URL for the FleetGo API.
# Development: leave as "/api/v1" to use the Vite dev-server proxy.
# Production:  set to the full API origin, e.g. https://api.fleetgo.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# Display name used in the UI shell.
VITE_APP_NAME=FleetGo

# Native tracking WebSocket uses the page origin by default (Vite proxies /api).
# For a separate production API origin, configure this public URL:
# VITE_TRACKING_WS_URL=wss://api.fleetgo.example.com/api/v1/tracking/ws

# Basemap URL and attribution are public configuration, not GPS credentials.
# Use a tile provider appropriate to production traffic. Set URL to none for no basemap.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
