{
  "name": "fleetgo-backend",
  "version": "1.0.0",
  "private": true,
  "description": "FleetGo \u00e2\u20ac\u201d Enterprise Fleet Logistics Management Platform (Backend API)",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "inventory:enable": "tsx scripts/enable-inventory.ts",
    "test:inventory": "node scripts/test-inventory.cjs",
    "operations:enable": "tsx scripts/enable-operations.ts",
    "test:operations": "node scripts/test-operations.cjs",
    "test:operations:guards": "node scripts/test-operations-guards.cjs",
    "tracking:enable": "tsx scripts/enable-tracking.ts",
    "test:tracking": "node scripts/test-tracking.cjs",
    "inspections:enable": "tsx scripts/enable-inspections.ts",
    "test:inspections": "node scripts/test-inspections.cjs",
    "test:reports": "node scripts/test-reports.cjs",
    "disk:enable": "tsx scripts/enable-disk-logistics.ts",
    "test:disk": "node scripts/test-disk.cjs",
    "vendors:enable": "tsx scripts/enable-vendors.ts",
    "test:vendors": "node scripts/test-vendors.cjs",
    "settings:enable": "tsx scripts/enable-settings.ts",
    "test:settings": "node scripts/test-settings.cjs",
    "claims:enable": "tsx scripts/enable-claims.ts",
    "test:claims": "node scripts/test-claims.cjs",
    "test:claims:required": "node --require tsx/cjs scripts/test-claims-required.cjs",
    "test:claims:currency": "node --require tsx/cjs scripts/test-claims-currency.cjs",
    "test:registration:inventory": "node --require tsx/cjs scripts/test-registration-inventory.cjs",
    "enable:all": "tsx scripts/enable-inventory.ts && tsx scripts/enable-operations.ts && tsx scripts/enable-tracking.ts && tsx scripts/enable-inspections.ts && tsx scripts/enable-disk-logistics.ts && tsx scripts/enable-vendors.ts && tsx scripts/enable-settings.ts && tsx scripts/enable-claims.ts",
    "setup:all": "prisma migrate deploy && prisma db seed && npm run enable:all"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "ws": "^8.22.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
