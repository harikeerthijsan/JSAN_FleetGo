# ============================================================================
# FleetGo Backend — Environment Configuration (EXAMPLE)
# Copy this file to `.env` and fill in real values for your environment.
# NEVER commit the real `.env` file or any secrets to version control.
# ============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# One of: development | production | test
NODE_ENV=development
APP_NAME=FleetGo
PORT=4000
# Prefix applied to every route group (keep in sync with the frontend).
API_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Database (PostgreSQL + Prisma)
# ---------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# This project uses a dedicated local PostgreSQL cluster on port 5433 (see the
# "Local database" section of the README for how to start it). Adjust to match
# your own PostgreSQL instance if different.
DATABASE_URL=postgresql://fleetgo:fleetgo_dev_pwd@localhost:5433/fleetgo?schema=public

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins (no trailing slash)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Logging — one of: error | warn | info | http | debug
# ---------------------------------------------------------------------------
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Authentication (Phase 2)
# Generate strong secrets, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Refresh-token cookie
REFRESH_COOKIE_NAME=fg_refresh
# Leave blank to derive from NODE_ENV (Secure in production). Set true/false to force.
COOKIE_SECURE=
# strict | lax | none  (use "none" only with Secure=true across sites)
COOKIE_SAMESITE=strict

# Password hashing cost (bcrypt rounds, 8-15)
BCRYPT_ROUNDS=12

# Login rate limiting / brute-force protection
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Password reset token lifetime (minutes)
PASSWORD_RESET_TTL_MIN=30

# ---------------------------------------------------------------------------
# File / Object Storage (uploads implemented in a later phase — readiness only)
# STORAGE_DRIVER: local | s3 | gcs
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_MAX_FILE_SIZE=10485760

# ---------------------------------------------------------------------------
# Live GPS tracking (Phase 7)
# ---------------------------------------------------------------------------
TRACKING_WS_ENABLED=true
# Defaults on in development; production requires an explicit true for simulations.
TRACKING_SIMULATION_ENABLED=true
# Comma-separated exact hostnames permitted for generic API pulls (HTTPS only).
GPS_API_ALLOWED_HOSTS=
# Choose your own GPS_ environment variable names in provider settings.
# Values belong only in backend deployment secrets, never frontend VITE_ variables.
GPS_PROVIDER_WEBHOOK_SECRET=
GPS_PROVIDER_API_URL=
GPS_PROVIDER_API_TOKEN=

# --- Phase 8: Inspection & Digital Handover ---------------------------------
# When true, dispatch confirmation additionally requires a COMPLETED pre-dispatch
# inspection to exist for every vehicle. Default off (a started pre-dispatch
# inspection must still be submitted before confirmation regardless).
INSPECTION_PREDISPATCH_REQUIRED=false
